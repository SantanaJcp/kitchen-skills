    },
    {
      "id": "main-to-feature",
      "guard": "deny-shared-push",
      "kind": "negative",
      "command": "git push origin main:feat/x",
      "expect": "allow"
    },
    {
      "id": "fetch",
      "guard": "deny-shared-push",
      "kind": "negative",
