{
  "about": "Attack corpus for hooks/kitchen-guard: each case runs as a PreToolUse payload. positive and bypass must deny (exit 2); negative must allow (exit 0); known-limit documents evasions the simplified shlex guard intentionally does not catch (allow).",
  "defaults": {
    "cwd": "project",
    "branch": "feat/x",
    "shared_branches_file": ["release/*"],
    "denylist": ["# invented terms", "Acmecorp", "zorblat"]
  },
  "cases": [
    {"id": "nv-commit-long", "kind": "positive", "command": "git commit --no-verify -m \"wip\"", "expect": "deny", "advice": "Run it without"},
    {"id": "nv-commit-short", "kind": "positive", "command": "git commit -n -m wip", "expect": "deny", "advice": "Run it without"},
    {"id": "nv-commit-cluster-anm", "kind": "positive", "command": "git commit -anm wip", "expect": "deny", "advice": "Run it without"},
    {"id": "nv-commit-abbreviated", "kind": "positive", "command": "git commit --no-veri -m x", "expect": "deny", "advice": "Run it without"},
    {"id": "nv-push-no-verify", "kind": "positive", "command": "git push --no-verify origin feat/x", "expect": "deny", "advice": "Run it without"},
    {"id": "nv-merge-no-verify", "kind": "positive", "command": "git merge --no-verify feat/x", "expect": "deny", "advice": "Run it without"},
    {"id": "nv-hookspath", "kind": "bypass", "command": "git -c core.hooksPath=/dev/null commit -m x", "expect": "deny", "advice": "Run it without"},
    {"id": "nv-sh-c", "kind": "bypass", "command": "sh -c 'git commit -n -m x'", "expect": "deny", "advice": "Run it without"},
    {"id": "nv-env-sudo", "kind": "bypass", "command": "env FOO=1 sudo git commit --no-verify -m x", "expect": "deny", "advice": "Run it without"},
    {"id": "nv-chained-and", "kind": "bypass", "command": "git add . && git commit -n -m x", "expect": "deny", "advice": "Run it without"},
    {"id": "nv-subshell", "kind": "bypass", "command": "(git commit -n -m x)", "expect": "deny", "advice": "Run it without"},
    {"id": "nv-git-C", "kind": "bypass", "command": "git -C . commit --no-verify -m x", "expect": "deny", "advice": "Run it without"},
    {"id": "nv-allow-normal-commit", "kind": "negative", "command": "git commit -m \"feat: add guard\"", "expect": "allow"},
    {"id": "nv-allow-mn-message", "kind": "negative", "command": "git commit -mn", "expect": "allow"},
    {"id": "nv-allow-message-text", "kind": "negative", "command": "git commit -m \"do not use --no-verify or -n\"", "expect": "allow"},
    {"id": "nv-allow-after-double-dash", "kind": "negative", "command": "git commit -m x -- --no-verify", "expect": "allow"},
    {"id": "nv-allow-heredoc-commit", "kind": "negative", "command": "git commit -F - <<'EOF'\nDon't skip hooks with --no-verify\nEOF", "expect": "allow"},

    {"id": "rm-root", "kind": "positive", "command": "rm -rf /srv/app", "expect": "deny", "advice": "trash "},
    {"id": "rm-home", "kind": "positive", "command": "rm -r ~/projects", "expect": "deny", "advice": "trash "},
    {"id": "rm-relative", "kind": "positive", "command": "rm -rf ./build", "expect": "deny", "advice": "trash "},
    {"id": "rm-long-recursive", "kind": "positive", "command": "rm --recursive /var/data", "expect": "deny", "advice": "trash "},
    {"id": "rm-capital-R", "kind": "positive", "command": "rm -R src", "expect": "deny", "advice": "trash "},
    {"id": "rm-tmp-root-itself", "kind": "positive", "command": "rm -rf /tmp", "expect": "deny", "advice": "trash "},
    {"id": "rm-dynamic-var", "kind": "positive", "command": "rm -rf \"$TARGET\"", "expect": "deny", "advice": "trash "},
    {"id": "rm-sh-c", "kind": "bypass", "command": "bash -c 'rm -rf /srv/app'", "expect": "deny", "advice": "trash "},
    {"id": "rm-sudo-time-nice", "kind": "bypass", "command": "time nice -n 5 sudo rm -rf /srv/app", "expect": "deny", "advice": "trash "},
    {"id": "rm-command-wrapper", "kind": "bypass", "command": "command rm -rf /srv/app", "expect": "deny", "advice": "trash "},
    {"id": "rm-semicolon", "kind": "bypass", "command": "echo hi; rm -rf /srv/app", "expect": "deny", "advice": "trash "},
    {"id": "rm-subshell-cd", "kind": "bypass", "command": "(cd /srv && rm -rf app)", "expect": "deny", "advice": "trash "},
    {"id": "rm-allow-single-file", "kind": "negative", "command": "rm -f build.log", "expect": "allow"},
    {"id": "rm-allow-tmp-sub", "kind": "negative", "command": "rm -rf /tmp/scratch-dir", "expect": "allow"},
    {"id": "rm-allow-tmp-glob", "kind": "negative", "command": "rm -rf /tmp/kitchen-*", "expect": "allow"},
    {"id": "rm-allow-cd-tmp", "kind": "negative", "command": "cd /tmp && rm -rf scratch-dir", "expect": "allow"},
    {"id": "rm-allow-cwd-tmp", "kind": "negative", "cwd": "tmp", "command": "rm -rf scratch-dir", "expect": "allow"},
    {"id": "rm-allow-quoted-text", "kind": "negative", "command": "echo \"rm -rf /\"", "expect": "allow"},

    {"id": "push-main", "kind": "positive", "command": "git push origin main", "expect": "deny", "advice": "Push your own branch"},
    {"id": "push-dev", "kind": "positive", "command": "git push origin dev", "expect": "deny", "advice": "Push your own branch"},
    {"id": "push-master", "kind": "positive", "command": "git push origin master", "expect": "deny", "advice": "Push your own branch"},
    {"id": "push-refspec-main", "kind": "positive", "command": "git push origin HEAD:main", "expect": "deny", "advice": "Push your own branch"},
    {"id": "push-force-refspec", "kind": "positive", "command": "git push origin +feat/x:refs/heads/dev", "expect": "deny", "advice": "Push your own branch"},
    {"id": "push-delete-main", "kind": "positive", "command": "git push origin --delete main", "expect": "deny", "advice": "Push your own branch"},
    {"id": "push-all", "kind": "positive", "command": "git push --all", "expect": "deny", "advice": "Push your own branch"},
    {"id": "push-mirror-abbrev", "kind": "positive", "command": "git push --mir", "expect": "deny", "advice": "Push your own branch"},
    {"id": "push-matching-colon", "kind": "positive", "command": "git push origin :", "expect": "deny", "advice": "Push your own branch"},
    {"id": "push-glob-release", "kind": "positive", "command": "git push origin release/1.0", "expect": "deny", "advice": "Push your own branch"},
    {"id": "push-bare-on-main", "kind": "positive", "branch": "main", "command": "git push", "expect": "deny", "advice": "Push your own branch"},
    {"id": "push-bare-upstream-dev", "kind": "positive", "branch": "feat/x", "upstream": "dev", "command": "git push", "expect": "deny", "advice": "Push your own branch"},
    {"id": "push-bare-matching-config", "kind": "positive", "push_default": "matching", "command": "git push", "expect": "deny", "advice": "Push your own branch"},
    {"id": "push-sh-c", "kind": "bypass", "command": "sh -c \"git push origin main\"", "expect": "deny", "advice": "Push your own branch"},
    {"id": "push-env-config", "kind": "bypass", "command": "git -c push.default=matching push", "expect": "deny", "advice": "Push your own branch"},
    {"id": "push-pipe-and-chain", "kind": "bypass", "command": "git status && git push origin dev", "expect": "deny", "advice": "Push your own branch"},
    {"id": "push-git-C-main", "kind": "bypass", "branch": "main", "command": "git -C . push", "expect": "deny", "advice": "Push your own branch"},
    {"id": "push-allow-feature", "kind": "negative", "command": "git push -u origin feat/x", "expect": "allow"},
    {"id": "push-allow-bare-feature", "kind": "negative", "branch": "feat/x", "command": "git push", "expect": "allow"},
    {"id": "push-allow-tag-named-main", "kind": "negative", "command": "git push origin tag main", "expect": "allow"},
    {"id": "push-allow-tags", "kind": "negative", "command": "git push origin --tags", "expect": "allow"},

    {"id": "pub-commit-denylist-kitchen", "kind": "positive", "cwd": "kitchen", "command": "git commit -m \"Add Acmecorp helper\"", "expect": "deny", "advice": "private denylist"},
    {"id": "pub-gh-pr-denylist-kitchen", "kind": "positive", "cwd": "kitchen", "command": "gh pr create --title x --body \"for zorblat\"", "expect": "deny", "advice": "private denylist"},
    {"id": "pub-heredoc-denylist-kitchen", "kind": "positive", "cwd": "kitchen", "command": "gh pr create --title x --body-file - <<'EOF'\nBuilt for Acmecorp\nEOF", "expect": "deny", "advice": "private denylist"},
    {"id": "pub-sh-c-denylist-kitchen", "kind": "bypass", "cwd": "kitchen", "command": "sh -c 'git commit -m \"Acmecorp\"'", "expect": "deny", "advice": "private denylist"},
    {"id": "pub-allow-other-repo", "kind": "negative", "command": "git commit -m \"Add Acmecorp helper\"", "expect": "allow"},
    {"id": "pub-allow-clean-kitchen", "kind": "negative", "cwd": "kitchen", "command": "git commit -m \"Add helper\"", "expect": "allow"},
    {"id": "pub-allow-tmp-body-file", "kind": "negative", "command": "gh pr create --title x --body-file /tmp/pr-body.md", "expect": "allow"},
    {"id": "pub-allow-tmp-commit-file", "kind": "negative", "cwd": "kitchen", "command": "git commit -F /tmp/nonexistent-clean.txt", "expect": "allow"},

    {"id": "parse-unterminated-git", "kind": "bypass", "command": "git commit -m \"unterminated", "expect": "deny", "advice": "cannot parse"},
    {"id": "parse-unterminated-rm", "kind": "bypass", "command": "rm -rf \"unterminated", "expect": "deny", "advice": "cannot parse"},
    {"id": "parse-allow-unterminated-other", "kind": "negative", "command": "echo \"unterminated", "expect": "allow"},

    {"id": "limit-eval", "kind": "known-limit", "command": "eval \"git push origin main\"", "expect": "allow", "limit": "eval is not expanded by the shlex splitter"},
    {"id": "limit-nested-cmdsub", "kind": "known-limit", "command": "$(echo git) push origin main", "expect": "allow", "limit": "nested $(...) command substitutions are not expanded"},
    {"id": "limit-xargs", "kind": "known-limit", "command": "echo /srv/app | xargs rm -rf", "expect": "allow", "limit": "xargs target arguments are not traced"},
    {"id": "limit-find-exec", "kind": "known-limit", "command": "find /srv/app -exec rm -rf {} +", "expect": "allow", "limit": "find -exec subcommands are not expanded"},
    {"id": "limit-ansi-c-escape", "kind": "known-limit", "command": "git commit $'\\x2d\\x2dno-verify' -m x", "expect": "allow", "limit": "ANSI-C $'...' hex/octal escapes are not decoded by shlex"},
    {"id": "limit-git-alias", "kind": "known-limit", "command": "git ship", "expect": "allow", "limit": "git aliases are not resolved"},
    {"id": "limit-script-file", "kind": "known-limit", "command": "./deploy.sh", "expect": "allow", "limit": "commands inside scripts on disk are not read"},
    {"id": "limit-piped-shell", "kind": "known-limit", "command": "echo 'git push origin main' | sh", "expect": "allow", "limit": "commands piped into a shell's stdin are not parsed"}
  ]
}
