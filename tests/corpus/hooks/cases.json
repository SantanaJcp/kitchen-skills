      "guard": "deny-shared-push",
      "kind": "known-limit",
      "command": "gh api -X PATCH repos/o/r/git/refs/heads/dev -f sha=abc",
      "expect": "allow",
      "limit": "updating a branch through the GitHub API or `gh` is not a git push."
    },
    {
      "id": "relative-dir",
      "guard": "deny-recursive-rm",
