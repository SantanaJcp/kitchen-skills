    {
      "id": "git-alias",
      "guard": "deny-shared-push",
      "kind": "known-limit",
      "command": "git p origin dev",
      "expect": "allow",
      "limit": "git aliases are not read."
    },
    {
      "id": "piped-to-shell",
      "guard": "deny-shared-push",
      "kind": "known-limit",
      "command": "echo \"git push origin dev\" | sh",
      "expect": "allow",
      "limit": "commands fed to a shell on stdin are not parsed."
    },
    {
