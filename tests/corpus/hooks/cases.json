      "command": "git push origin feat/dev-tools",
      "expect": "allow"
    },
    {
      "id": "tag",
      "guard": "deny-shared-push",
      "kind": "negative",
      "command": "git push origin tag v1",
      "expect": "allow"
    },
    {
      "id": "tags-option",
      "guard": "deny-shared-push",
      "kind": "negative",
      "command": "git push origin v1.0 --tags",
      "expect": "allow"
    },
    {
      "id": "echo-only",
      "guard": "deny-shared-push",
      "kind": "negative",
