#!/usr/bin/env python3
"""PreToolUse guard: deny recursive `rm` outside the temp dir; point to the Trash instead.

Principles: `doors` (a deletion outside git cannot be undone)."""
import os
import sys
import tempfile

sys.dont_write_bytecode = True

GUARD = "deny-recursive-rm"
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
try:
    import shellparse  # noqa: E402
except Exception as error:  # noqa: BLE001 - a guard that cannot load must block, not exit 1
    sys.stderr.write(f"Blocked by the kitchen hook {GUARD}: cannot load hooks/shellparse.py ({error}). Run `kitchen doctor`.\n")
    sys.exit(2)


def temp_roots():
    return {os.path.realpath(tempfile.gettempdir()), os.path.realpath("/tmp")}


def within(path, roots, allow_root):
    return any(path == root and allow_root or path.startswith(root.rstrip("/") + "/") for root in roots)


def advice(target):
    return (f"Move it to the Trash instead: `trash {target}` (on Linux: `gio trash {target}`). "
            "Recursive rm is allowed only under the temp dir (/tmp or $TMPDIR).")


def target_problem(arg, cwd, roots):
    if arg.dynamic:
        return f"`rm -r {arg.value}`: cannot tell whether that path is inside the temp dir. Write the path literally. "
    path = shellparse.join_path(cwd, arg.value)
    if path is None:
        return f"`rm -r {arg.value}`: the working directory is unknown after a `cd`, so the path cannot be checked. "
    parts = path.split("/")
    first_glob = next((i for i, part in enumerate(parts) if arg.glob and any(c in part for c in "*?[")), None)
    if first_glob is None:
        if within(os.path.realpath(path), roots, allow_root=False):
            return None
    else:
        base = "/".join(parts[:first_glob]) or "/"
        if ".." not in parts[first_glob:] and within(os.path.realpath(base), roots, allow_root=True):
            return None
    return f"`rm -r {arg.value}` is outside the temp dir. "


def abbreviates(option, full):
    """getopt accepts any unambiguous prefix of a long option: --rec is --recursive."""
    return len(option) > 2 and full.startswith(option)


def rm_targets(args):
    recursive, targets, options_done = False, [], False
    for arg in args:
        if not options_done and not arg.dynamic and arg.value == "--":
            options_done = True
        elif not options_done and not arg.dynamic and arg.value.startswith("--"):
            recursive = recursive or abbreviates(arg.value, "--recursive")
        elif not options_done and not arg.dynamic and arg.value.startswith("-") and len(arg.value) > 1:
            recursive = recursive or "r" in arg.value or "R" in arg.value
        else:
            targets.append(arg)
    return recursive, targets


def check(commands):
    roots = temp_roots()
    reasons = []
    for cmd in commands:
        if cmd.name != "rm":
            continue
        recursive, targets = rm_targets(cmd.argv[1:])
        if not recursive:
            continue
        if cmd.more_args:
            reasons.append("`rm -r` on paths read from input (xargs, find -exec) cannot be checked. "
                           "List the paths, and move them to the Trash: `trash <path>` (on Linux: `gio trash <path>`).")
            continue
        for target in targets:
            problem = target_problem(target, cmd.cwd, roots)
            if problem:
                reasons.append(problem + advice(target.value))
    return reasons


if __name__ == "__main__":
    shellparse.main(GUARD, check)
