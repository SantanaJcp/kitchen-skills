#!/usr/bin/env python3
"""SessionStart `compact` hook: remind the agent of the 13 principles and chef-mode SKILL.md after compaction.

No transcript parsing: always prints the 13 one-line principles and a one-line re-read prompt.
Principles: `handoff` (the agent after a compaction is the next agent)."""
from __future__ import annotations

import json
import os
import sys

sys.dont_write_bytecode = True

PRINCIPLES = [
    "- `prove`: prove it on the real thing before claiming done, fixed, or safe; a test must fail without the change.",
    "- `truthful-state`: unknown is never green; never invent counts, freshness, progress, or success.",
    "- `no-fallbacks`: fail loud; no silent alternative path or substitute value (session-model exception is said aloud).",
    "- `root-cause`: reproduce red first, form falsifiable hypotheses, fix the cause and the same pattern elsewhere.",
    "- `encode-lessons`: a repeated correction is an environment defect; fix at the strongest layer (code -> test -> hook -> rule -> skill).",
    "- `owner-attention`: spend the owner's attention only on decisions; act on reversible work and surface only exceptions.",
    "- `doors`: two-way doors follow the project's `Autonomy:` rung; one-way doors get two options and approval first.",
    "- `evidence`: label every claim measured (command + output), inferred (file:line), or guess.",
    "- `small-owned`: prefer the smallest change; keep skills short and guard the context window.",
    "- `isolate`: separate worktrees/clones before sharing; operations converge idempotently.",
    "- `cross-review`: another model reviews risky diffs on a two-round budget (P0/P1 only on round 2).",
    "- `handoff`: every brief stands alone (goal, scope, SHA, verify, PASS/ISSUES/BLOCKED); search decisions.md with grep.",
    "- `design`: shape data and types so the wrong thing is hard to write; validate at the edges.",
]


def main() -> None:
    skill = "~/.claude/skills/chef-mode/SKILL.md" if os.environ.get("CLAUDE_PROJECT_DIR") else "~/.agents/skills/chef-mode/SKILL.md"
    context = "\n".join([
        f"If you were in chef mode, re-read {skill} now.",
        "",
        "Kitchen principles:",
        *PRINCIPLES,
    ]) + "\n"
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": context}}))


if __name__ == "__main__":
    main()
