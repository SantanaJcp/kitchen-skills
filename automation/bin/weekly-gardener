#!/usr/bin/env bash
# Weekly gardener: one unattended Claude Code run that opens at most one small, verified PR.
# Principles: `doors` (a PR, never a merge), `prove` (the job reruns the checks), `isolate` (a sealed sandbox).
# Skips while a previous gardener PR is still open, so reviews never pile up.
# Generation and publication are separate:
#   1. Claude runs sealed: no gh, no tokens, no SSH, no git credentials, push URL refused; its Bash runs in
#      Claude Code's OS sandbox (no reads of credential locations, writes and network only where configured,
#      see lib/sandbox_settings.py). It may only commit on a local branch gardener/<date>-<slug> and write a
#      PR summary file.
#   2. After Claude exits, this script validates the branch's final tree against origin/$BRANCH: the only
#      gardener branch, 1+ commits, at most GARDENER_MAX_CHANGED_LINES changed lines (default 400), none of
#      GARDENER_PROTECTED_PATHS (default: .github/*), no credential-looking content in the added lines
#      (lib/scan_diff.py). It then publishes ONE new commit holding exactly that
#      validated tree on top of origin/$BRANCH, never the agent's history (a file added and removed again
#      there would otherwise be published), and opens the PR.
#   3. Before publishing, the job reruns GARDENER_VERIFY_STEPS itself on that exact tree, written from the
#      objects (lib/export_tree.py: no .gitattributes, filters or hooks) and sandboxed by srt
#      (lib/sandbox_settings.py --format srt, the agent's boundary). A step passes only when its strict shell
#      exits 0 and says so; a failing, killed or hung step publishes nothing, and so does an empty
#      GARDENER_VERIFY_STEPS. The PR body lists the steps that passed.
# The agent works in a fresh clone of its own ($WORK_DIR/clone, deleted at the end); the job never runs git
# with that clone's config or hooks. It lists the agent's branch, imports the objects into a bare repository
# of its own ($JOB_DIR, which the agent cannot write), checks them with git fsck and publishes from there.
# Every run ends with exactly one result, logged as one GARDENER-RESULT line and recorded as one line in
# $STATE_ROOT/gardener/<project>.jsonl for `kitchen status`: published <url>, none <reason> (nothing to publish, or
# skipped), refused <reason>, or incomplete <reason> (a prerequisite failed, claude failed, or the run was aborted,
# interrupted or killed). A refused or incomplete run also shows a local notification (lib/kitchen/notify.py).
# A run skipped as busy never held the lock: it only logs, and writes no record, so it can neither mask the result of
# the run that held the lock nor race that run's own writes to the record.
# The sealed run and the publication live in lib/sealed.sh, shared with bin/daily-audit. GARDENER_MODEL and
# GARDENER_EFFORT pass as claude's --model and --effort when set; unset, Claude Code's defaults apply.
# Usage: weekly-gardener <project>
source "$(dirname "$0")/../lib/common.sh" "$1" gardener
AGENT_KIND=gardener
source "$KITCHEN_AUTOMATION/lib/sealed.sh"

STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%S+00:00)"
RESULT=""         # published / none / refused / incomplete, set once by result()
BUSY=0            # 1 when the lock stayed taken: such a run records nothing
RESULT_DETAIL=""
RUN_LOG="$LOG_DIR/gardener-$RUN_ID.log"
WORK_DIR="$STATE_DIR/gardener/$RUN_ID"
SUMMARY_FILE="$WORK_DIR/summary.md"
AGENT_CLONE="$WORK_DIR/clone"
JOB_DIR="$STATE_DIR/gardener-job/$RUN_ID"  # outside every path the agent may write: settings, exports, PR text
exec > >(tee -a "$RUN_LOG") 2>&1

MAX_CHANGED_LINES="${GARDENER_MAX_CHANGED_LINES:-400}"
declare -p GARDENER_PROTECTED_PATHS >/dev/null 2>&1 || GARDENER_PROTECTED_PATHS=(".github/*")
declare -p GARDENER_VERIFY_STEPS >/dev/null 2>&1 || GARDENER_VERIFY_STEPS=()  # name|command, rerun by the job
PROTECTED_PATHS=(${GARDENER_PROTECTED_PATHS[@]+"${GARDENER_PROTECTED_PATHS[@]}"})
EDIT_PATHS=()
VERIFY_STEPS=(${GARDENER_VERIFY_STEPS[@]+"${GARDENER_VERIFY_STEPS[@]}"})
VERIFY_STEPS_NAME=GARDENER_VERIFY_STEPS
PUBLISH_LABEL="$GARDENER_LABEL"
RESULT_TAG=GARDENER-RESULT
AGENT_ENV=(GARDENER_BRANCH_PREFIX="gardener/$RUN_DATE-" GARDENER_SUMMARY_FILE="$SUMMARY_FILE")
AGENT_DIRS=("$HISTORY_DIR")
PROMPT_FILE="${GARDENER_PROMPT_FILE:-$KITCHEN_AUTOMATION/prompts/gardener.md}"  # override only for canary probes
STARTED=0

# The run's one result (see the top of this file); finish records it.
result() { RESULT="$1"; RESULT_DETAIL="$2"; log "GARDENER-RESULT: $1 - $2"; }
refuse() { result refused "$1"; return 1; }
stop() { result incomplete "$1"; exit 1; }

finish() {
  local rc=$?
  trap - EXIT INT TERM HUP
  set +e
  unset GIT_DIR  # set for publish only; a signal can arrive while it runs
  cleanup_agent_run "$STARTED"
  if [ "$BUSY" = 0 ]; then
    [ -n "$RESULT" ] || result incomplete "aborted (exit $rc)"
    case "$RESULT" in
      refused|incomplete) notify "kitchen gardener: $PROJECT $RESULT" "$RESULT_DETAIL" || warn "not notified: see the log" ;;
    esac
    record_gardener "$RESULT" "$RESULT_DETAIL" "$RUN_ID" "$RUN_LOG" "$STARTED_AT" ${WARNINGS[@]+"${WARNINGS[@]}"} ||
      log "FAILED to write the gardener record $GARDENER_RECORD"
  fi
  log "gardener end: status=$rc"
  exit "$rc"
}
trap finish EXIT
trap 'log "gardener interrupted (SIGINT)"; exit 130' INT
trap 'log "gardener interrupted (SIGTERM)"; exit 143' TERM
trap 'log "gardener interrupted (SIGHUP)"; exit 129' HUP

if [ "$LOCK_STATE" = busy ]; then
  log "gardener skipped: busy (another job of $PROJECT held the clone for ${LOCK_WAIT_SECONDS:-3600}s); not recorded"
  BUSY=1
  exit 75
fi
close_stale_records "$RUN_ID" "$GARDENER_RECORD"
record_gardener running "" "$RUN_ID" "$RUN_LOG" "$STARTED_AT"
# Without verification of its own the job would publish nothing (verify_tree refuses too): no agent run for it.
[ ${#GARDENER_VERIFY_STEPS[@]} -gt 0 ] ||
  { refuse "no independent verification configured (GARDENER_VERIFY_STEPS is empty); the agent did not run"; exit 1; }
bad_steps="$(malformed_steps "${GARDENER_VERIFY_STEPS[@]}")"
[ -z "$bad_steps" ] ||
  { refuse "GARDENER_VERIFY_STEPS has a step that is not name|command with both parts ($(printf '%s' "$bad_steps" | tr '\n' ';')); the agent did not run"; exit 1; }

gh label create "$GARDENER_LABEL" -R "$GH_REPO" --color 0E8A16 --description "Weekly gardener PR" >/dev/null 2>&1 || true
pending="$(gh pr list -R "$GH_REPO" --label "$GARDENER_LABEL" --state open --json number --jq 'length')"
if [ "${pending:-0}" -gt 0 ]; then
  result none "gardener skipped: $pending gardener PR(s) still open"; exit 0
fi

log "gardener start: project=$PROJECT"
sync_clone
cd "$CLONE_DIR"
BASE_SHA="$(git rev-parse --verify "origin/$BRANCH^{commit}")"  # pinned before the agent can touch refs
mkdir -p "$WORK_DIR"
mkdir -p -m 700 "$JOB_DIR"
make_agent_clone "$BASE_SHA"
if [ "${NEEDS_DOCKER:-0}" = 1 ] && ! docker_ready; then
  stop "Docker is required and not available; the gardener could not verify its change"
fi
require_srt
sandbox_platform
# Optional: refresh what the sandboxes read offline (package caches) before the agent runs. It runs
# unsandboxed, with the network, on reviewed code only: a fresh export of the pinned base, never the agent's
# tree. A failure stops the run, since the job's verification would then fail on the stale caches anyway.
if [ -n "${GARDENER_PREPARE_CMD:-}" ]; then
  log "prepare: $GARDENER_PREPARE_CMD"
  python3 "$KITCHEN_AUTOMATION/lib/export_tree.py" "$CLONE_DIR" "$BASE_SHA^{tree}" "$JOB_DIR/prepare" >/dev/null || {
    stop "could not export $BASE_SHA to run GARDENER_PREPARE_CMD"; }
  if ! (cd "$JOB_DIR/prepare" && bounded "$NET_TIMEOUT" bash -e -o pipefail -c "$GARDENER_PREPARE_CMD") \
    > "$LOG_DIR/gardener-$RUN_ID-prepare.log" 2>&1; then
    stop "GARDENER_PREPARE_CMD failed; log $LOG_DIR/gardener-$RUN_ID-prepare.log"
  fi
  rm -rf "$JOB_DIR/prepare"
fi
write_agent_settings

VERIFY_NAMES=""
for spec in ${GARDENER_VERIFY_STEPS[@]+"${GARDENER_VERIFY_STEPS[@]}"}; do VERIFY_NAMES+="${VERIFY_NAMES:+, }${spec%%|*}"; done
PROMPT="$(cat "$PROMPT_FILE")

Project facts:
- base branch: $BRANCH
- your branch name: gardener/$RUN_DATE-<slug> (exactly one branch)
- PR summary file: $SUMMARY_FILE
- largest diff the job will publish: $MAX_CHANGED_LINES changed lines
- paths the job refuses to publish: ${GARDENER_PROTECTED_PATHS[*]:-none}
- quality metrics command: ${QUALITY_CMD:-none configured}
- steps the job reruns on your final tree before publishing (same sandbox, no Docker): ${VERIFY_NAMES:-none configured, so the job will refuse to publish}
- committed baseline: ${BASELINE_FILE:-none configured}
- metrics history (one JSON object per nightly run): $HISTORY_DIR/history.jsonl
- run id: $RUN_ID"

STARTED=1
status=0
run_agent "$PROMPT" "" "${GARDENER_MODEL:-}" "${GARDENER_EFFORT:-}" || status=$?
if [ "$status" != 0 ]; then
  result incomplete "claude exited $status; nothing published"
  exit "$status"
fi
GIT_DIR="$JOB_DIR/publish.git" publish || exit 1
if [ -z "$PUBLISHED_URL" ]; then
  result none "no gardener branch was committed"
else
  RESULT=published RESULT_DETAIL="$PUBLISHED_URL"
fi
