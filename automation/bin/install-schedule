#!/usr/bin/env bash
# Schedules the nightly guard: launchd on macOS, systemd user timer on Linux.
# Usage: install-schedule [--guard] <project> [hour]    (default: 02:00 daily)
set -euo pipefail

[ "${1:-}" = --guard ] && shift
PROJECT="${1:?usage: install-schedule <project> [hour]}"
HOUR="${2:-2}"

AUTOMATION="$(cd "$(dirname "$0")/.." && pwd)"
STATE_ROOT="${KITCHEN_STATE:-$HOME/.local/state/kitchen}"
CONFIG="${KITCHEN_CONFIG:-$HOME/.config/kitchen}/automation/$PROJECT.env"
[ -f "$CONFIG" ] || { echo "no config for $PROJECT ($CONFIG)" >&2; exit 2; }

PLATFORM="$(uname)"
case "$PLATFORM" in
  Darwin) AGENTS="$HOME/Library/LaunchAgents" ;;
  Linux)
    AGENTS="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
    if [ "$(loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null)" != yes ]; then
      echo "lingering is off for $(id -un): timers would stop at logout. Run: loginctl enable-linger $(id -un)" >&2
      exit 2
    fi ;;
  *) echo "install-schedule supports macOS (launchd) and Linux (systemd) only" >&2; exit 2 ;;
esac
mkdir -p "$AGENTS"

LOG_DIR="$STATE_ROOT/automation/$PROJECT/logs"
mkdir -p "$LOG_DIR"

if [ "$PLATFORM" = Darwin ]; then
  LABEL="com.kitchen.$PROJECT.nightly-guard"
  PLIST="$AGENTS/$LABEL.plist"
  # ProcessType Standard, not Background: macOS throttles Background jobs' CPU and I/O.
  cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>$AUTOMATION/bin/nightly-guard</string><string>$PROJECT</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>$HOUR</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>$LOG_DIR/launchd.log</string>
  <key>StandardErrorPath</key><string>$LOG_DIR/launchd.log</string>
  <key>ProcessType</key><string>Standard</string>
</dict>
</plist>
PLIST
  launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$PLIST"
  echo "scheduled $LABEL"
else
  LABEL="kitchen-${PROJECT//./-}-nightly-guard"
  for arg in /bin/bash "$AUTOMATION/bin/nightly-guard" "$PROJECT"; do
    [[ "$arg" =~ ^[A-Za-z0-9_./@+-]+$ ]] || { echo "install-schedule: cannot pass '$arg' to systemd unquoted; move kitchen to a plain path" >&2; exit 2; }
  done
  ON_CALENDAR="*-*-* $(printf '%02d' "$HOUR"):00:00"
  cat > "$AGENTS/$LABEL.service" <<UNIT
[Unit]
Description=kitchen $LABEL

[Service]
Type=oneshot
ExecStart=/bin/bash $AUTOMATION/bin/nightly-guard $PROJECT
StandardOutput=append:$LOG_DIR/systemd.log
StandardError=append:$LOG_DIR/systemd.log
UNIT
  cat > "$AGENTS/$LABEL.timer" <<UNIT
[Unit]
Description=kitchen $LABEL

[Timer]
OnCalendar=$ON_CALENDAR

[Install]
WantedBy=timers.target
UNIT
  systemctl --user daemon-reload
  systemctl --user enable --now "$LABEL.timer" >/dev/null
  echo "scheduled $LABEL ($ON_CALENDAR)"
fi
