#!/usr/bin/env bash
# Schedules the kitchen jobs: launchd on macOS, systemd user timers on Linux.
# Usage:
#   install-schedule <project> [guard-hour] [gardener-weekday] [gardener-hour]   defaults: 02:00 daily, Monday 06:00
#   install-schedule --gardener <project> [weekday] [hour]                       the gardener alone; default Monday 06:00
#   install-schedule --guard <project> [hour]                                     the nightly guard alone; default 02:00 daily
#   install-schedule --audit <project> [hour]                                     the daily audit; default 04:00, after the guard
#   install-schedule --retro [weekday] [hour]                                    default: Monday 07:00
# Weekdays are numbered as launchd does: 0 or 7 Sunday, 1 Monday ... 6 Saturday.
set -euo pipefail

AUTOMATION="$(cd "$(dirname "$0")/.." && pwd)"
STATE_ROOT="${KITCHEN_STATE:-$HOME/.local/state/kitchen}"
PLATFORM="$(uname)"
case "$PLATFORM" in
  Darwin) AGENTS="$HOME/Library/LaunchAgents" ;;
  Linux)
    AGENTS="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
    # User timers stop with the user's last session unless lingering is on.
    if [ "$(loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null)" != yes ]; then
      echo "lingering is off for $(id -un): timers would stop at logout. Run: loginctl enable-linger $(id -un)" >&2
      exit 2
    fi ;;
  *) echo "install-schedule supports macOS (launchd) and Linux (systemd) only" >&2; exit 2 ;;
esac
mkdir -p "$AGENTS"

# ProcessType Standard, not Background: macOS throttles Background jobs' CPU and I/O, which roughly doubled the
# nightly's test time and tripped a project's 3-minute test timeout (measured 2026-10-05: 4m38s and 6m11s
# scheduled vs 2m40s to 3m09s run by hand).
write_plist() { # label log-dir weekday-or-empty hour program-args...
  local label="$1" log_dir="$2" weekday="$3" hour="$4"; shift 4
  local plist="$AGENTS/$label.plist" args="" calendar="<dict>"
  for arg in "$@"; do args="$args<string>$arg</string>"; done
  [ -z "$weekday" ] || calendar="$calendar<key>Weekday</key><integer>$weekday</integer>"
  calendar="$calendar<key>Hour</key><integer>$hour</integer><key>Minute</key><integer>0</integer></dict>"
  mkdir -p "$log_dir"
  cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key>
  <array>$args</array>
  <key>StartCalendarInterval</key>$calendar
  <key>StandardOutPath</key><string>$log_dir/launchd.log</string>
  <key>StandardErrorPath</key><string>$log_dir/launchd.log</string>
  <key>ProcessType</key><string>Standard</string>
</dict>
</plist>
PLIST
  launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$plist"
  echo "scheduled $label"
}

# PrivateTmp=yes gives each run a /tmp of its own: the gardener's sandboxes need to write /tmp on Linux and
# refuse to run without it.
write_units() { # label log-dir weekday-or-empty hour program-args...
  local label="$1" log_dir="$2" weekday="$3" hour="$4"; shift 4
  local days=(Sun Mon Tue Wed Thu Fri Sat Sun) exec_line="" arg on_calendar
  for arg in "$@"; do
    # systemd has its own quoting and % specifiers: refuse what would need either rather than half-escape it
    [[ "$arg" =~ ^[A-Za-z0-9_./@+-]+$ ]] || { echo "install-schedule: cannot pass '$arg' to systemd unquoted; move kitchen to a plain path" >&2; exit 2; }
    exec_line="$exec_line $arg"
  done
  on_calendar="*-*-* $(printf '%02d' "$hour"):00:00"
  [ -z "$weekday" ] || on_calendar="${days[$weekday]} $on_calendar"
  mkdir -p "$log_dir"
  cat > "$AGENTS/$label.service" <<UNIT
[Unit]
Description=kitchen $label

[Service]
Type=oneshot
ExecStart=${exec_line# }
PrivateTmp=yes
StandardOutput=append:$log_dir/systemd.log
StandardError=append:$log_dir/systemd.log
UNIT
  cat > "$AGENTS/$label.timer" <<UNIT
[Unit]
Description=kitchen $label

[Timer]
OnCalendar=$on_calendar

[Install]
WantedBy=timers.target
UNIT
  systemctl --user daemon-reload
  systemctl --user enable --now "$label.timer" >/dev/null
  echo "scheduled $label ($on_calendar)"
}

schedule() {
  if [ "$PLATFORM" = Darwin ]; then write_plist "com.kitchen.$1" "${@:2}"; else write_units "kitchen-${1//./-}" "${@:2}"; fi
}

needs_config() {
  [ -f "${KITCHEN_CONFIG:-$HOME/.config/kitchen}/automation/$1.env" ] || { echo "no config for $1" >&2; exit 2; }
}

install_srt() {
  # The gardener reruns its checks under srt, pinned with its integrity hashes in package-lock.json.
  npm ci --ignore-scripts --no-audit --no-fund --prefix "$AUTOMATION" >/dev/null
  echo "installed srt $("$AUTOMATION/node_modules/.bin/srt" --version)"
}

case "${1:-}" in
  --retro)
    schedule retro "$STATE_ROOT/retro/logs" "${2:-1}" "${3:-7}" /bin/bash "$AUTOMATION/bin/weekly-retro" ;;
  --guard)
    PROJECT="${2:?usage: install-schedule --guard <project> [hour]}"
    needs_config "$PROJECT"
    schedule "$PROJECT.nightly-guard" "$STATE_ROOT/automation/$PROJECT/logs" "" "${3:-2}" \
      /bin/bash "$AUTOMATION/bin/nightly-guard" "$PROJECT" ;;
  --audit)
    # No catch-up of a missed run (no Persistent=): it waits for the next one, after the next guard (owner, 2026-10-12).
    PROJECT="${2:?usage: install-schedule --audit <project> [hour]}"
    needs_config "$PROJECT"
    install_srt
    schedule "$PROJECT.daily-audit" "$STATE_ROOT/automation/$PROJECT/logs" "" "${3:-4}" \
      /bin/bash "$AUTOMATION/bin/daily-audit" "$PROJECT" ;;
  --gardener)
    PROJECT="${2:?usage: install-schedule --gardener <project> [weekday] [hour]}"
    needs_config "$PROJECT"
    install_srt
    schedule "$PROJECT.weekly-gardener" "$STATE_ROOT/automation/$PROJECT/logs" "${3:-1}" "${4:-6}" \
      /bin/bash "$AUTOMATION/bin/weekly-gardener" "$PROJECT" ;;
  *)
    PROJECT="${1:?usage: install-schedule <project> | --guard <project> | --gardener <project> | --audit <project> | --retro}"
    needs_config "$PROJECT"
    install_srt
    schedule "$PROJECT.nightly-guard" "$STATE_ROOT/automation/$PROJECT/logs" "" "${2:-2}" \
      /bin/bash "$AUTOMATION/bin/nightly-guard" "$PROJECT"
    schedule "$PROJECT.weekly-gardener" "$STATE_ROOT/automation/$PROJECT/logs" "${3:-1}" "${4:-6}" \
      /bin/bash "$AUTOMATION/bin/weekly-gardener" "$PROJECT" ;;
esac
